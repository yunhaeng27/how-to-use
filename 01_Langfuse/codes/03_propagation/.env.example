# 마스터 에이전트 자신의 LLM 호출 (GenOS 서빙 게이트웨이 — 02_langfuse_evaluation/.env 와 동일 값 재사용 가능)
GENOS_BEARER_TOKEN=
GENOS_URL=https://genos.genon.ai
GENOS_SERVING_ID=1009
GENOS_MODEL=z-ai/glm-5.2

# 02(RAG) 서브에이전트 호출 — GenOS 코드서빙 게이트웨이 경유
# GenOS admin > 코드서빙 배포(02_langfuse_evaluation) 에서 code_serving_id 와 발급된 bearer
# token 을 확인해 채운다. code_serving_id 만 알고 리비전을 특정할 필요 없으면
# RAG_SUBAGENT_CODE_SERVING_REVISION_ID 는 비워도 된다.
RAG_SUBAGENT_CODE_SERVING_ID=
RAG_SUBAGENT_CODE_SERVING_REVISION_ID=
RAG_SUBAGENT_BEARER_TOKEN=

# 로컬 테스트용 우회로 — 값이 있으면 위 code_serving_id/bearer token 대신 이 base URL 로 직접
# 호출한다 (예: 02_langfuse_evaluation 을 로컬에서 `uv run uvicorn main:app --port 8001` 로 띄운 경우)
RAG_SUBAGENT_BASE_URL=

# 아래 3개를 전부 채우면 Langfuse 계측이 활성화된다 (하나라도 비우면 no-op).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
